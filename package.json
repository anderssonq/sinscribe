{
  "name": "sinscribe",
  "version": "0.1.0-beta.0",
  "description": "A git-centric developer-workflow assistant CLI: PR descriptions, commit messages, branch names, project context briefs, and AI agent context files.",
  "license": "MIT",
  "author": "Andersson Quintero (https://github.com/anderssonq)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anderssonq/sinscribe.git"
  },
  "homepage": "https://github.com/anderssonq/sinscribe#readme",
  "bugs": "https://github.com/anderssonq/sinscribe/issues",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sinscribe": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "git",
    "cli",
    "pull-request",
    "commit",
    "conventional-commits",
    "gitmoji"
  ],
  "scripts": {
    "sinscribe": "node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli.tsx",
    "dev-watch": "tsx watch src/cli.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run lint:check && pnpm run format:check && pnpm test && pnpm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.5.3",
    "@langchain/openrouter": "^0.4.3",
    "deepagents": "^1.10.5",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
